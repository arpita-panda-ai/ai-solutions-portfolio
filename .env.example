# Copy this file to .env.local and fill in your own key to enable AI-assisted triage.
# Without this set, the Triage Copilot still works fully using the rules-based engine —
# the "Also run AI-assisted triage (Claude)" option will just fall back to rules-only.

ANTHROPIC_API_KEY=

# Optional overrides:
# TRIAGE_LLM_MODEL=claude-haiku-4-5-20251001
# TRIAGE_LLM_MAX_CALLS=30   # hard cap on Claude calls per server instance, for cost control
